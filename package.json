{
  "name": "ai-friendly",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "build": "bun run --workspaces --if-present build && bun apps/home/build-site.ts",
    "check": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
